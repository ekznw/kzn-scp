446},","  volume  = {10},","  cid     = {JA_Pebesma_2018_RJ},","  journal = {{The R Journal}},","  year    = {2018},","}","","","@Dataset{ekwgi2018knl-a,","  author = {{Ezemvelo KZN Wildlife \u0026 GEOTERRA Image}},","  title  = {KwaZulu-Natal Land-Cover 2017 V1 GIS Coverage [KZN_2017_Comparable_Landcover_V1_grid_w31 .zip]. Pietermaritzburg, ZA},","  cid    = {MS_EKZNW_GeoTERRA_2018},","  year   = {2018},","}","","","@Article{skowno2021sar-a,","  author   = {Andrew Luke Skowno and Maphale Stella Monyeki},","  title    = {South Africa's Red List of Terrestrial Ecosystems (RLEs)},","  doi      = {10.3390/land10101048},","  issn     = {2073-445X},","  number   = {10},","  url      = {https://www.mdpi.com/2073-445X/10/10/1048},","  volume   = {10},","  abstract = {Ecosystem level indicators are emerging as important pillars of the post-2020 global biodiversity framework of the Convention on Biological Diversity; at the same time, the IUCN Red List of Ecosystems (RLEs) is experiencing rapid global uptake. We applied a systematic RLE assessment to 456 terrestrial ecosystems in South Africa between 2017 and 2021. What sets South Africa apart in this endeavour is that an independently formulated ecosystem threat status indicator was developed between 2004 and 2008 and the list of threatened ecosystems (effectively a proto RLE) was integrated into the national environmental regulatory framework in 2011. Through this, Critically Endangered and Endangered types were afforded a form of statutory protection through increased regulation of land-use change activities. We describe the transition to the IUCN RLE framework and focus on both the technical steps of incorporating the best available data into a credible assessment, and the unique social and legal processes to ensure that the biodiversity conservation sector in South Africa understood and supported the proposed replacement of the existing list of threatened ecosystems (2011) with the RLE (2021). We discuss the policy development steps required in South Africa, and the pros and cons of maintaining a legislative link for RLE implementation.},","  cid      = {JA_Skowno_2021_L},","  file     = {:skowno2021sar-a.pdf:PDF},","  journal  = {Land},","  year     = {2021},","}","","","@Article{krueger2014tit-a,","  author  = {Sonja Kr{\\\"u}ger and D.~G. Allan and A.~R. Jenkins and A. Amar},","  title   = {Trends in territory occupancy, distribution and density of the {Bearded Vulture \\textit{Gypaetus barbatus meridionalis} in southern Africa}},","  doi     = {10.1017/S0959270913000440},","  pages   = {162--177},","  volume  = {24},","  cid     = {JA_Kruger_2014_BCI},","  journal = {Bird Conservation International},","  year    = {2014},","}","","@TechReport{skowno2025nba-a,","  author      = {Andrew L. Skowno and Carol J. Poole and Natasha A. Besseling and Jock C. Currie and Jessica M. {da Silva} and Anisha Dayaram and Linda R. Harris and Nancy Job and Maphale S. Monyeki and Hlengiwe Mtshali and Domitilla C. Raimondo and Kerry J. Sink and Megan G. {van der Bank} and Dewidine {van der Colff} and Lara {van Niekerk} and Lize {von Staden}},","  institution = {{{South African National Biodiversity Institute}}},","  title       = {National Biodiversity Assessment 2025: The status of South Africa's biodiversity. Summary of Findings and Key Messages},","  type        = {techreport},","  url         = {https://hdl.handle.net/20.500.12143/9467},","  address     = {Pretoria, ZA.},","  file        = {:skowno2025nba-a.pdf:PDF},","  year        = {2025},","}","","@Article{hesselbarth2019lao-a,","  author    = {Hesselbarth, Maximilian HK and Sciaini, Marco and With, Kimberly A and Wiegand, Kerstin and Nowosad, Jakub},","  title     = {landscapemetrics: an open-source R tool to calculate landscape metrics},","  doi       = {https://doi.org/10.1111/ecog.04617},","  number    = {10},","  pages     = {1648--1657},","  volume    = {42},","  journal   = {Ecography},","  publisher = {Wiley Online Library},","  ye